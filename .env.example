# AI Enterprise OS — environment configuration template.
#
# Copy this file to `.env` for local overrides and never commit `.env`.
# `.env` and `.env.*` are gitignored; `.env.example` is the committed
# reference. Values shown are the defaults — uncomment to override.

# Disable colored output from the CLI (Rich). Set to any non-empty value.
# NO_COLOR=1

# (Reserved) Override the runtime data directory used by telemetry and
# state. Defaults to ./runtime relative to the working directory.
# AI_COMPANY_RUNTIME_DIR=runtime
