{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",

      "options": {
        "baseURL": "http://localhost:11434/v1"
      },

      "models": {
        "llama3.1:8b": {
          "name": "Llama 3.1 8B"
        },

        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },

        "mistral:7b": {
          "name": "Mistral 7B"
        },

        "deepseek-r1-64k:latest": {
          "name": "DeepSeek R1 7B 64K"
        }
      }
    }
  },

  "model": "ollama/llama3.1:8b",

  "small_model": "ollama/qwen2.5-coder:7b",

  "agent": {
    "build": {
      "model": "ollama/llama3.1:8b"
    },

    "plan": {
      "model": "ollama/deepseek-r1-64k:latest"
    },

    "explore": {
      "model": "ollama/mistral:7b"
    },

    "general": {
      "model": "ollama/qwen2.5-coder:7b"
    },

    "architect": {
      "model": "opencode/north-mini-code-free",
      "mode": "primary",
      "description": "Architecture agent used by ai-company generate targets for repo-level design and artifact generation (reconciled 2026-08-01, Phase 0 WS-0.3)"
    }
  },

  "default_agent": "build",

  "permission": "allow",

  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  }
}
