{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/llama3.1:8b",
  "small_model": "ollama/qwen2.5-coder:7b",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434"
      }
    }
  },
  "agent": {
    "build": {
      "model": "ollama/llama3.1:8b",
      "mode": "primary",
      "description": "General-purpose builder agent using Llama 3.1 8B"
    },
    "plan": {
      "model": "ollama/qwen2.5-coder:7b",
      "mode": "primary",
      "description": "Planning agent using Qwen 2.5 Coder 7B for complex reasoning"
    },
    "explore": {
      "model": "ollama/mistral:7b",
      "mode": "primary",
      "description": "Code exploration agent using Mistral 7B"
    },
    "general": {
      "model": "ollama/llama3.1:8b",
      "mode": "primary",
      "description": "General-purpose agent using Llama 3.1 8B"
    },
    "architect": {
      "model": "opencode/north-mini-code-free",
      "mode": "primary",
      "description": "Architecture agent used by ai-company generate targets for repo-level design and artifact generation (reconciled 2026-08-01, Phase 0 WS-0.3)"
    }
  },
  "default_agent": "build"
}
